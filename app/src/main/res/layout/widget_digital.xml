<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/bg_panel" android:gravity="center" android:orientation="vertical" android:padding="8dp">
    <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:format12Hour="hh:mm" android:format24Hour="HH:mm"
        android:fontFamily="sans-serif-medium" android:textColor="#FFFFFF" android:textSize="32sp" android:letterSpacing="0.06" />
    <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:format12Hour="MM-dd EEEE" android:format24Hour="MM-dd EEEE"
        android:textColor="#D9FFFFFF" android:textSize="11sp" />
</LinearLayout>
