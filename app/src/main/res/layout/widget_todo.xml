<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/bg_glass" android:orientation="vertical"
    android:paddingStart="16dp" android:paddingTop="10dp" android:paddingEnd="12dp" android:paddingBottom="8dp">
    <TextView android:id="@+id/todo_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="4dp" android:fontFamily="casual" android:text="To do list"
        android:textColor="#FFFFFF" android:textSize="16sp" />
    <LinearLayout android:id="@+id/row0" android:layout_width="match_parent" android:layout_height="26dp"
        android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/check0" android:layout_width="15dp" android:layout_height="15dp"
            android:src="@drawable/ic_check_off" />
        <TextView android:id="@+id/text0" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:ellipsize="end" android:maxLines="1"
            android:textColor="#FFFFFF" android:textSize="13sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row1" android:layout_width="match_parent" android:layout_height="26dp"
        android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/check1" android:layout_width="15dp" android:layout_height="15dp"
            android:src="@drawable/ic_check_off" />
        <TextView android:id="@+id/text1" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:ellipsize="end" android:maxLines="1"
            android:textColor="#FFFFFF" android:textSize="13sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row2" android:layout_width="match_parent" android:layout_height="26dp"
        android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/check2" android:layout_width="15dp" android:layout_height="15dp"
            android:src="@drawable/ic_check_off" />
        <TextView android:id="@+id/text2" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:ellipsize="end" android:maxLines="1"
            android:textColor="#FFFFFF" android:textSize="13sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row3" android:layout_width="match_parent" android:layout_height="26dp"
        android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/check3" android:layout_width="15dp" android:layout_height="15dp"
            android:src="@drawable/ic_check_off" />
        <TextView android:id="@+id/text3" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:ellipsize="end" android:maxLines="1"
            android:textColor="#FFFFFF" android:textSize="13sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row4" android:layout_width="match_parent" android:layout_height="26dp"
        android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/check4" android:layout_width="15dp" android:layout_height="15dp"
            android:src="@drawable/ic_check_off" />
        <TextView android:id="@+id/text4" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:ellipsize="end" android:maxLines="1"
            android:textColor="#FFFFFF" android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
